  {
    "category": "SPACE",
    "path": "space/carina-nebula.jpg",
    "author": "NASA/ESA/CSA/STScI",
    "title": "Cosmic Cliffs in the Carina Nebula",
    "description": "What looks like craggy mountains on a moonlit evening is actually the edge of a nearby, young, star-forming region NGC 3324 in the Carina Nebula. Captured in infrared light by the James Webb Space Telescope's NIRCam, this image reveals previously invisible areas of star birth."
  },
  {
    "category": "SPACE",
    "path": "space/southern-ring-nebula.jpg",
    "author": "NASA/ESA/CSA/STScI",
    "title": "Southern Ring Nebula (NIRCam and MIRI)",
    "description": "This side-by-side comparison shows the Southern Ring Nebula in near-infrared and mid-infrared light from the James Webb Space Telescope. This planetary nebula was created by a dying star that shed its outer layers over thousands of years."
  },
  {
    "category": "SPACE",
    "path": "space/webb-first-deep-field.jpg",
    "author": "NASA/ESA/CSA/STScI",
    "title": "Webb's First Deep Field — SMACS 0723",
    "description": "Thousands of galaxies flood this near-infrared image of galaxy cluster SMACS 0723. This is the deepest and sharpest infrared image of the distant universe ever taken, looking back over 13 billion years. Gravitational lensing by the massive cluster magnifies even more distant galaxies behind it."
  },
  {
    "category": "SPACE",
    "path": "space/dark-matter-map.jpg",
    "author": "NASA/ESA/CSA",
    "title": "Webb Reveals Dark Matter Map",
    "description": "This image from NASA's James Webb Space Telescope, containing nearly 800,000 galaxies, is overlaid with a map of dark matter represented in blue. Brighter blue areas indicate a higher density of dark matter. Researchers used Webb data to find the dark matter distribution across this vast cosmic field."
  },
  {
    "category": "SPACE",
    "path": "space/wolf-rayet-140.jpg",
    "author": "NASA/ESA/CSA/STScI",
    "title": "Wolf-Rayet 140 — Cosmic Dust Rings",
    "description": "This stunning James Webb Space Telescope image reveals at least 17 concentric dust rings emanating from a pair of stars known as Wolf-Rayet 140, located over 5,000 light-years from Earth. Each ring was created when the two stars came close together in their orbit, compressing stellar winds and forming new layers of dust."
  },
  {
    "category": "SPACE",
    "path": "space/orion-nebula-infrared.jpg",
    "author": "NASA/ESA/CSA",
    "title": "Orion Nebula in Webb Infrared",
    "description": "This image of the Orion Nebula produced using Webb telescope data shows two enormous caverns carved out by unseen giant stars that can release up to a million times more light than our Sun. The infrared view reveals intricate details of gas, dust, and newly forming stars invisible to optical telescopes."
  },
  {
    "category": "SPACE",
    "path": "space/phantom-galaxy-m74.png",
    "author": "NASA/ESA/CSA/STScI",
    "title": "Phantom Galaxy — M74 Core",
    "description": "The James Webb Space Telescope's mid-infrared view of the heart of the Phantom Galaxy (M74) reveals delicate filaments of gas and dust in the spiral arms winding outward from the center. The lack of gas in the nuclear region provides an unobscured view of the nuclear star cluster at the galaxy's center."
  }
]
